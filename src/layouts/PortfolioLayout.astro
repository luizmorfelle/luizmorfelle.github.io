---
import '../styles/global.css';
import type { Locale } from '../data/portfolio';
interface Props { title:string; description:string; locale:Locale; canonicalUrl:string; alternateUrls:{pt:string;en:string}; }
const {title,description,locale,canonicalUrl,alternateUrls}=Astro.props;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f3f0e8"/><link rel="canonical" href={canonicalUrl}/><link rel="alternate" hreflang="pt-BR" href={alternateUrls.pt}/><link rel="alternate" hreflang="en" href={alternateUrls.en}/><title>{title}</title></head><body><slot/></body></html>
