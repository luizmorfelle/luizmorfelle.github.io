---
interface Props { skills:string[]; education:{degree:string;institution:string;period:string}; languages:string[]; sections:{skills:string;education:string;languages:string}; }
const {skills,education,languages,sections}=Astro.props;
---
<section class="section wrap profile-section"><div class="profile-grid"><section id="skills" aria-labelledby="skills-title"><p class="eyebrow">03 / {sections.skills}</p><h2 id="skills-title">{sections.skills}</h2><div class="tag-list">{skills.map(skill=><span class="skill-chip">{skill}</span>)}</div></section><section id="education" aria-labelledby="education-title"><p class="eyebrow">04 / {sections.education}</p><h2 id="education-title">{sections.education}</h2><article class="education-card"><h3>{education.degree}</h3><p>{education.institution}</p><span>{education.period}</span></article></section><section id="languages" aria-labelledby="languages-title"><p class="eyebrow">05 / {sections.languages}</p><h2 id="languages-title">{sections.languages}</h2><ul class="language-list">{languages.map(language=><li>{language}</li>)}</ul></section></div></section>
