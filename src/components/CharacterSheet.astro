---
interface Props { name:string; role:string; headline:string; summary:string; skills:string[]; contact:{email:string;linkedin:string;github:string}; labels:{character:string;contact:string}; }
const {name,role,headline,summary,skills,contact,labels}=Astro.props;
---
<section class="hero wrap" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">{labels.character} <span>· lvl ∞</span></p><h1 id="hero-title">{name}</h1><p class="role">{role}</p><h2>{headline}</h2><p class="summary">{summary}</p><div class="hero-actions"><a class="button button-primary" href={`mailto:${contact.email}`}>{labels.contact}<span aria-hidden="true"> ↗</span></a><a class="text-link" href={contact.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="text-link" href={contact.github} target="_blank" rel="noreferrer">GitHub ↗</a></div></div><aside class="character-card" aria-label={labels.character}><div class="avatar" aria-hidden="true"><span>LM</span><i></i></div><div class="card-caption"><span>CLASS</span><b>FULL-STACK</b></div><div class="card-caption"><span>BASE</span><b>TIJUCAS, BR</b></div><div class="mini-stats"><span>Curiosity <b>99</b></span><span>Craft <b>∞</b></span></div><span class="card-spark" aria-hidden="true">✳</span></aside><div class="skill-strip"><span class="eyebrow">CORE SKILLS</span>{skills.slice(0,7).map(skill=><span class="skill-chip">{skill}</span>)}</div></section>
