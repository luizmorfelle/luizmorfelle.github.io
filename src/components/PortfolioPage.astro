---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import SiteHeader from './SiteHeader.astro';
import CharacterSheet from './CharacterSheet.astro';
import QuestLog from './QuestLog.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import ProfileDetails from './ProfileDetails.astro';
import ContactSection from './ContactSection.astro';
import InventoryEasterEggs from './InventoryEasterEggs.astro';
import type { Locale, PortfolioContent } from '../data/portfolio';
interface Props {locale:Locale;content:PortfolioContent;canonicalUrl:string}
const {locale,content,canonicalUrl}=Astro.props;
const alternates={pt:'https://luizmorfelle.github.io/pt/',en:'https://luizmorfelle.github.io/en/'};
---
<PortfolioLayout title={content.title} description={content.description} locale={locale} canonicalUrl={canonicalUrl} alternateUrls={alternates}><SiteHeader locale={locale} navigation={content.navigation}/><main><CharacterSheet name={content.name} role={content.role} headline={content.headline} summary={content.summary} skills={content.skills} contact={content.contact} labels={{character:content.sections.character,contact:content.actions.contact}}/><QuestLog quests={content.quests} title={content.sections.quests} actions={content.actions}/><ExperienceTimeline experience={content.experience} title={content.sections.experience}/>
<ProfileDetails skills={content.skills} education={content.education} languages={content.languages} sections={content.sections}/><section class="section wrap inventory-section" id="inventory" aria-labelledby="inventory-title"><div class="section-heading"><p class="eyebrow">SIDE QUEST / ???</p><h2 id="inventory-title">{content.sections.inventory}</h2></div><InventoryEasterEggs/></section><ContactSection contact={content.contact} title={content.sections.contact} cta={content.actions.contact} locale={locale}/></main></PortfolioLayout>
