---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import SiteHeader from './SiteHeader.astro';
import CharacterSheet from './CharacterSheet.astro';
import type { Locale, PortfolioContent } from '../data/portfolio';
interface Props {locale:Locale;content:PortfolioContent;canonicalUrl:string}
const {locale,content,canonicalUrl}=Astro.props;
const alternates={pt:'https://luizmorfelle.github.io/pt/',en:'https://luizmorfelle.github.io/en/'};
---
<PortfolioLayout title={content.title} description={content.description} locale={locale} canonicalUrl={canonicalUrl} alternateUrls={alternates}><SiteHeader locale={locale} navigation={content.navigation}/><main><CharacterSheet name={content.name} role={content.role} headline={content.headline} summary={content.summary} skills={content.skills} contact={content.contact} labels={{character:content.sections.character,contact:content.actions.contact}}/><section class="placeholder wrap" id="quests"><p class="eyebrow">01 / {content.sections.quests}</p><h2>{content.sections.quests}</h2><p>{content.locale==='en'?'Selected work, told as small quests.':'Projetos selecionados, contados como pequenas quests.'}</p></section><section class="placeholder wrap" id="experience"><p class="eyebrow">02 / {content.sections.experience}</p><h2>{content.sections.experience}</h2></section><section class="placeholder wrap" id="inventory"><p class="eyebrow">03 / {content.sections.inventory}</p><h2>{content.sections.inventory}</h2></section><section class="placeholder wrap" id="contact"><p class="eyebrow">04 / {content.sections.contact}</p><h2>{content.sections.contact}</h2></section></main></PortfolioLayout>
