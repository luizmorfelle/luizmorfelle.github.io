---
import type { Experience } from '../data/portfolio';
interface Props { experience:Experience[]; title:string; }
const {experience,title}=Astro.props;
---
<section class="section wrap" id="experience" aria-labelledby="experience-title"><div class="section-heading"><p class="eyebrow">02 / CAREER LOG</p><h2 id="experience-title">{title}</h2></div><div class="timeline">{[...experience].reverse().map((job)=><article class="timeline-entry"><div class="timeline-date">{job.period}</div><div class="timeline-content"><h3>{job.company}</h3><p class="timeline-role">{job.role} <span>· {job.location}</span></p><ul>{job.highlights.map(item=><li>{item}</li>)}</ul><div class="tag-list">{job.technologies.map(tech=><span class="skill-chip">{tech}</span>)}</div></div></article>)}</div></section>
